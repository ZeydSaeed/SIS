    "production": [
      {
        "id": "SEC-PROD-001",
        "severity": "P0",
        "rule": "Production must run with DEBUG=false and secure cookies",
        "enforcement": ["config", "deployment"],
        "test": "security:validate config checks",
        "exception_policy": "none"
      }
    ]
