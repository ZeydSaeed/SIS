{
  "version": "1.1.0",
  "maturity_target": "Level 3",
  "categories": {
    "authentication": [
      {
        "id": "SEC-AUTH-001",
        "severity": "P0",
        "rule": "Protected API resources require authenticated access",
        "enforcement": ["runtime", "static", "test", "ci"],
        "test": "tests/Feature/Security/StudentApiAuthorizationTest.php",
        "exception_policy": "documented_in_SECURITY-EXCEPTIONS.yaml"
      },
      {
        "id": "SEC-AUTH-002",
        "severity": "P0",
        "rule": "Passwords must never be stored or logged in plaintext",
        "enforcement": ["runtime", "static", "ci"],
        "test": "tests/Unit/Security/SecurityStaticAnalyzerTest.php",
        "exception_policy": "none"
      },
      {
        "id": "SEC-AUTH-003",
        "severity": "P1",
        "rule": "Production password policy enforces minimum complexity",
        "enforcement": ["runtime", "config"],
        "test": "AppServiceProvider Password::defaults",
        "exception_policy": "none"
      }
    ],
    "authorization": [
      {
        "id": "SEC-AUTHZ-001",
        "severity": "P0",
        "rule": "Deny-by-default — protected resources require explicit policy permission",
        "enforcement": ["runtime", "static", "test", "ci"],
        "test": "tests/Feature/Security/StudentApiAuthorizationTest.php",
        "exception_policy": "documented_in_SECURITY-EXCEPTIONS.yaml"
      },
      {
        "id": "SEC-AUTHZ-002",
        "severity": "P0",
        "rule": "Form requests for sensitive writes must not use authorize(): true without exception",
        "enforcement": ["static", "ci"],
        "test": "SecurityArchitectureValidator",
        "exception_policy": "documented_in_SECURITY-EXCEPTIONS.yaml"
      },
      {
        "id": "SEC-AUTHZ-003",
        "severity": "P1",
        "rule": "PII fields require explicit permission to expose in API responses",
        "enforcement": ["runtime", "test"],
        "test": "tests/Feature/Security/StudentApiAuthorizationTest.php",
        "exception_policy": "none"
      },
      {
        "id": "SEC-AUTHZ-004",
        "severity": "P0",
        "rule": "School-scoped resources require permission + valid school context + resource school ownership",
        "enforcement": ["runtime", "test", "ci"],
        "test": "tests/Feature/Security/CrossSchoolAuthorizationTest.php",
        "exception_policy": "none"
      },
      {
        "id": "SEC-AUTHZ-005",
        "severity": "P0",
        "rule": "Explicit X-School-Id header required — implicit single-school auto-resolve disabled",
        "enforcement": ["runtime", "test", "ci"],
        "test": "tests/Feature/Security/SchoolContextRequiredTest.php",
        "exception_policy": "none"
      }
    ],
    "session": [
      {
        "id": "SEC-SESSION-001",
        "severity": "P1",
        "rule": "Session cookies must be encrypted and HttpOnly where applicable",
        "enforcement": ["config", "runtime"],
        "test": "Laravel defaults + bootstrap/app.php",
        "exception_policy": "none"
      }
    ],
    "csrf": [
      {
        "id": "SEC-CSRF-001",
        "severity": "P0",
        "rule": "Browser session mutations require CSRF protection",
        "enforcement": ["runtime", "config"],
        "test": "Laravel web middleware stack",
        "exception_policy": "documented_in_SECURITY-EXCEPTIONS.yaml"
      }
    ],
    "api": [
      {
        "id": "SEC-API-001",
        "severity": "P0",
        "rule": "API errors must not expose stack traces, SQL, or secrets in production",
        "enforcement": ["runtime", "config"],
        "test": "APP_DEBUG=false in production",
        "exception_policy": "none"
      },
      {
        "id": "SEC-API-002",
        "severity": "P1",
        "rule": "API routes must carry correlation ID",
        "enforcement": ["runtime", "test"],
        "test": "CorrelationIdMiddleware",
        "exception_policy": "none"
      }
