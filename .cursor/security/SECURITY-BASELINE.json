    "rate_limiting": [
      {
        "id": "SEC-RATE-001",
        "severity": "P1",
        "rule": "Authenticated API routes must have classified rate limits",
        "enforcement": ["runtime", "config"],
        "test": "bootstrap/app.php RateLimiter",
        "exception_policy": "none"
      }
    ],
    "input_validation": [
      {
        "id": "SEC-INPUT-001",
        "severity": "P0",
        "rule": "Every mutating endpoint must validate input via FormRequest or validated DTO",
        "enforcement": ["static", "test", "ci"],
        "test": "Feature API tests",
        "exception_policy": "documented_in_SECURITY-EXCEPTIONS.yaml"
      },
      {
        "id": "SEC-INPUT-002",
        "severity": "P0",
        "rule": "Security-sensitive fields (role, permissions, school_id, created_by, etc.) prohibited in client payloads",
        "enforcement": ["runtime", "test", "ci"],
        "test": "tests/Feature/Security/MassAssignmentProtectionTest.php",
        "exception_policy": "none"
      }
    ],
    "output_encoding": [
      {
        "id": "SEC-OUTPUT-001",
        "severity": "P1",
        "rule": "JSON responses must not include unsanitized user HTML",
