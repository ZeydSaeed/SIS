        "test": "SecurityStaticAnalyzer patterns",
        "exception_policy": "none"
      }
    ],
    "audit": [
      {
        "id": "SEC-AUDIT-001",
        "severity": "P0",
        "rule": "Security events persist to security.security_audit_logs with redacted metadata",
