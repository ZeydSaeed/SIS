        "test": "SecurityStaticAnalyzer",
        "exception_policy": "documented_in_SECURITY-EXCEPTIONS.yaml"
      },
      {
        "id": "SEC-DB-002",
        "severity": "P1",
        "rule": "Destructive DB commands prohibited in production",
        "enforcement": ["runtime"],
        "test": "DB::prohibitDestructiveCommands",
        "exception_policy": "none"
      },
      {
        "id": "SEC-DB-003",
        "severity": "P0",
        "rule": "RLS school-scoped tables fail-closed when app.current_school_id is missing or empty",
        "enforcement": ["runtime", "test", "ci"],
        "test": "tests/Feature/Security/PostgreSqlRlsFailClosedTest.php",
        "exception_policy": "none"
      }
    ],
    "secrets": [
      {
        "id": "SEC-SECRET-001",
        "severity": "P0",
        "rule": "No production secrets in source control",
        "enforcement": ["ci", "static"],
        "test": "SecretScanner + security:validate",
        "exception_policy": "documented_in_SECURITY-EXCEPTIONS.yaml"
      }
    ],
    "logging": [
      {
        "id": "SEC-LOG-001",
        "severity": "P0",
        "rule": "Must not log passwords, tokens, or API keys",
