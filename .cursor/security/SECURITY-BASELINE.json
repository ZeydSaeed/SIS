        "test": "tests/Feature/Security/SecurityAuditPersistenceTest.php",
        "exception_policy": "none"
      }
    ],
    "headers": [
      {
        "id": "SEC-HEADER-001",
        "severity": "P2",
        "rule": "Security headers applied to HTTP responses",
        "enforcement": ["runtime"],
        "test": "SecurityHeadersMiddleware",
        "exception_policy": "none"
      }
    ],
    "dependencies": [
      {
        "id": "SEC-DEP-001",
        "severity": "P0",
        "rule": "Critical/High composer advisories block CI (composer audit --no-dev)",
        "enforcement": ["ci"],
        "test": "tests/Unit/Security/ComposerAuditGateTest.php + composer test",
        "exception_policy": "documented_in_COMPOSER-AUDIT-POLICY.json"
      }
    ],
    "ci": [
      {
        "id": "SEC-CI-001",
        "severity": "P0",
        "rule": "P0/P1 security findings block merge via CI gate",
        "enforcement": ["ci"],
        "test": "composer test includes security:validate + composer audit",
        "exception_policy": "none"
      }
    ],
    "intelligence": [
      {
        "id": "SEC-INTEL-001",
        "severity": "P0",
        "rule": "Intelligence layer cannot grant permissions or bypass authorization",
        "enforcement": ["static", "test", "ci"],
        "test": "IntelligenceGovernanceChecker",
        "exception_policy": "none"
      },
      {
        "id": "SEC-INTEL-002",
        "severity": "P0",
        "rule": "Production autonomous execution must remain blocked",
        "enforcement": ["runtime", "static", "test", "ci"],
        "test": "AutonomousExecutionPolicy tests",
        "exception_policy": "none"
      }
