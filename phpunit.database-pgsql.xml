<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!-- Disposable PostgreSQL only. NEVER set DB_DATABASE=sis here. -->
    <testsuites>
        <testsuite name="DatabasePostgreSql">
            <file>tests/Feature/Database/PostgreSqlFoundationVerificationTest.php</file>
            <directory>tests/Feature/Database/PostgreSql</directory>
            <directory>tests/Feature/Security/PostgreSql</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="SIS_ENV_PROFILE" value="testing"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="sis_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="root"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SIS_SCHEDULER_INTELLIGENCE" value="false"/>
        <env name="SIS_SCHEDULER_OPTIMIZATION" value="false"/>
        <env name="SIS_PROTECTED_DATABASES" value="sis"/>
        <env name="SIS_DESTRUCTIVE_ALLOWED_DATABASES" value="sis_test,:memory:"/>
    </php>
</phpunit>
