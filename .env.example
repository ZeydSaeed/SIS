APP_NAME=SIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://sis.test

# SIS environment profile: local | testing | staging | production
# Aligns scheduler, cache, queue, and database expectations (see config/sis.php)
SIS_ENV_PROFILE=local
SIS_API_VERSION=0.1.0

# HTTP request telemetry (Phase 3.4)
SIS_HTTP_TELEMETRY_ENABLED=true
SIS_SLOW_QUERY_THRESHOLD_MS=10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (recommended for SIS — Herd/Valet default)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sis
DB_USERNAME=root
DB_PASSWORD=

# SQLite fallback (CI fast tests — see phpunit.xml)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# PostgreSQL search path for multi-schema SIS (uncomment when using PG)
# DB_SEARCH_PATH=public,organization,academic,vocational,students,guardians,enrollment,teachers,curriculum,timetable,attendance,exams,results,security,audit,reports,intelligence

# SIS Database Intelligence Platform (Runtime)
INTELLIGENCE_ENABLED=true
INTELLIGENCE_AUTO_MAX_TIER=1
INTELLIGENCE_SELF_HEALING=true
INTELLIGENCE_PG_STAT=true
INTELLIGENCE_PG_STAT_TOP=50

# Scheduler profile gates (unset = profile default from config/sis.php)
# SIS_SCHEDULER_INTELLIGENCE=true
# SIS_SCHEDULER_OPTIMIZATION=true

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Optimization / Self-Healing (Phase 2A–2B.2 safety pipeline)
# Production autonomous ANALYZE is NOT authorized — keep observe in production.
# ---------------------------------------------------------------------------

OPTIMIZATION_ENABLED=true
OPTIMIZATION_MODE=observe

# Hard block production autonomous — do NOT disable in production
OPTIMIZATION_AUTONOMOUS_BLOCK_PRODUCTION=true

# Controlled autonomous ANALYZE — local/staging only; NEVER include production
OPTIMIZATION_AUTONOMOUS_REQUIRE_CONTROLLED_ENV=true
OPTIMIZATION_AUTONOMOUS_CONTROLLED_ENVIRONMENTS=local,staging

# Emergency kill switch (fail-closed when true)
OPTIMIZATION_AUTONOMOUS_KILL_SWITCH=false

# Explicit allowlist — required for any autonomous ANALYZE attempt
# OPTIMIZATION_ANALYZE_ALLOWED_TARGETS=intelligence.optimization_validation_target

# Rate limits (per hour window unless noted)
OPTIMIZATION_AUTONOMOUS_MAX_PER_CYCLE=1
OPTIMIZATION_AUTONOMOUS_MAX_PER_TARGET_PER_HOUR=3
OPTIMIZATION_AUTONOMOUS_MAX_GLOBAL_PER_HOUR=10
OPTIMIZATION_AUTONOMOUS_RATE_WINDOW_MINUTES=60

OPTIMIZATION_ANALYZE_TIMEOUT_SECONDS=30
OPTIMIZATION_ROLLBACK_ENABLED=true
OPTIMIZATION_UNIFIED_SAFETY_PIPELINE=true
